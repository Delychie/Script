<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         fsociety mask — Mr. Robot. Top hat, monocle, handlebar
         'stache and a wide grin. Pure vector: scales to any size,
         no external asset, razor-sharp on high-DPI.
         Drop it anywhere with:  <Image Source="{StaticResource FsocietyMask}" />
         ============================================================ -->

    <DrawingImage x:Key="FsocietyMask">
        <DrawingImage.Drawing>
            <DrawingGroup>

                <!-- faint terminal-green glow behind the mask -->
                <GeometryDrawing Brush="#1F2BE86B">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="100,118" RadiusX="92" RadiusY="90" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- face -->
                <GeometryDrawing Brush="#EDE7D6">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 100,54 C 62,54 48,82 48,112
                                               C 48,148 72,178 100,184
                                               C 128,178 152,148 152,112
                                               C 152,82 138,54 100,54 Z" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- top hat brim + crown -->
                <GeometryDrawing Brush="#0C0C0C">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="100,54" RadiusX="60" RadiusY="12" />
                            <PathGeometry Figures="M 77,54 L 77,23 Q 77,15 85,15
                                                   L 115,15 Q 123,15 123,23 L 123,54 Z" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- hat band (fsociety red) -->
                <GeometryDrawing Brush="#E5352B">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 77,45 L 123,45 L 123,53 L 77,53 Z" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- eyebrows (raised, jaunty) -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#141414" Thickness="5" StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <PathGeometry Figures="M 62,90 Q 80,80 97,91" />
                            <PathGeometry Figures="M 103,91 Q 120,80 138,90" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- eyes -->
                <GeometryDrawing Brush="#141414">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="79,107" RadiusX="11" RadiusY="13" />
                            <EllipseGeometry Center="121,107" RadiusX="11" RadiusY="13" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- eye glints -->
                <GeometryDrawing Brush="#FAFAF4">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="75,102" RadiusX="3" RadiusY="3.4" />
                            <EllipseGeometry Center="117,102" RadiusX="3" RadiusY="3.4" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- monocle ring + chain (phosphor green) -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#2BE86B" Thickness="3" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="121,107" RadiusX="19" RadiusY="19" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#2BE86B" Thickness="1.6" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 139,116 Q 150,140 145,162" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- handlebar moustache -->
                <GeometryDrawing Brush="#141414">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 100,126 C 86,128 74,130 64,123
                                               C 68,140 86,142 100,132
                                               C 114,142 132,140 136,123
                                               C 126,130 114,128 100,126 Z" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- wide grin (open) -->
                <GeometryDrawing Brush="#1A130E">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 70,140 Q 100,182 130,140
                                               Q 100,160 70,140 Z" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- pointed goatee -->
                <GeometryDrawing Brush="#141414">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 90,161 Q 100,171 110,161 L 100,187 Z" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>
