<Window x:Class="FsocietyInjector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Administrator: Command Prompt - fsociety.exe"
        Height="600" Width="880"
        MinHeight="360" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="False"
        Background="{StaticResource ConsoleBrush}"
        UseLayoutRounding="True"
        FontFamily="Consolas, Lucida Console, Courier New"
        TextOptions.TextFormattingMode="Display">

    <!-- Square window with a thin border, like a console window -->
    <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- title bar   -->
                <RowDefinition Height="*" />      <!-- output      -->
                <RowDefinition Height="Auto" />   <!-- prompt input -->
            </Grid.RowDefinitions>

            <!-- ============================ TITLE BAR (Win10 light) ============================ -->
            <Border x:Name="TitleBar" Grid.Row="0" Height="30"
                    Background="{StaticResource CaptionBarBrush}"
                    BorderBrush="#D9D9D9" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0,0,0">
                        <!-- tiny console icon -->
                        <Border Width="14" Height="14" Margin="0,0,8,0"
                                Background="#0C0C0C" BorderBrush="#7A7A7A" BorderThickness="1">
                            <TextBlock Text="&gt;_" FontSize="8" Foreground="#CCCCCC"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Administrator: Command Prompt - fsociety.exe"
                                   FontFamily="Segoe UI" FontSize="12"
                                   Foreground="{StaticResource CaptionTextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button x:Name="BtnMin" Style="{StaticResource CaptionButton}"
                                Content="&#x2013;" Click="BtnMin_Click" />
                        <Button x:Name="BtnMax" Style="{StaticResource CaptionButton}"
                                Content="&#x2610;" Click="BtnMax_Click" />
                        <Button x:Name="BtnClose" Style="{StaticResource CloseCaptionButton}"
                                Content="&#x2715;" Click="BtnClose_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================ OUTPUT ============================ -->
            <RichTextBox x:Name="Out" Grid.Row="1"
                         Background="{StaticResource ConsoleBrush}"
                         Foreground="{StaticResource FgBrush}"
                         BorderThickness="0" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                         FontSize="14" Padding="12,8,12,0"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         IsTabStop="False" Focusable="False">
                <RichTextBox.Resources>
                    <Style TargetType="Paragraph">
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </RichTextBox.Resources>
                <FlowDocument x:Name="Doc" />
            </RichTextBox>

            <!-- ============================ PROMPT INPUT ============================ -->
            <Grid Grid.Row="2" Background="{StaticResource ConsoleBrush}">
                <StackPanel Orientation="Horizontal" Margin="12,2,12,10" VerticalAlignment="Center">
                    <TextBlock x:Name="PromptLabel" Text="C:\fsociety&gt;"
                               Foreground="{StaticResource FgBrush}" FontSize="14"
                               VerticalAlignment="Center" />
                    <TextBox x:Name="Cmd"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource FgBrush}"
                             CaretBrush="{StaticResource FgBrush}"
                             SelectionBrush="#3A5F3A"
                             FontFamily="Consolas, Lucida Console, Courier New" FontSize="14"
                             MinWidth="600" VerticalAlignment="Center"
                             KeyDown="Cmd_KeyDown" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
