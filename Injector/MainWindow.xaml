<Window x:Class="FsocietyInjector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="fsociety injector"
        Height="640" Width="960"
        MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" FontFamily="Consolas">

    <!-- Rounded, borderless shell -->
    <Border CornerRadius="18" Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="0" Opacity="0.6" />
        </Border.Effect>

        <Grid Margin="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- title bar   -->
                <RowDefinition Height="*" />      <!-- content     -->
                <RowDefinition Height="Auto" />   <!-- footer      -->
            </Grid.RowDefinitions>

            <!-- ============================ TITLE BAR ============================ -->
            <Border x:Name="TitleBar" Grid.Row="0" Background="Transparent"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Padding="18,14,10,10">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{StaticResource FsocietyMask}" Width="44" Height="44" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="f" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource AccentABrush}" />
                                <TextBlock Text="society" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource Text0Brush}" />
                            </StackPanel>
                            <TextBlock Text="DLL INJECTOR · HELLO, FRIEND" FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text2Brush}"
                                       Margin="1,1,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                        <Button x:Name="BtnMin" Style="{StaticResource ChromeButton}"
                                Content="&#xE921;" FontFamily="Segoe MDL2 Assets"
                                FontSize="10" Click="BtnMin_Click" ToolTip="Minimise" />
                        <Button x:Name="BtnClose" Style="{StaticResource CloseButton}"
                                Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                                FontSize="11" Click="BtnClose_Click" ToolTip="Close" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- society gradient hairline under the header -->
            <Border Grid.Row="0" Height="2" VerticalAlignment="Bottom" Margin="18,0"
                    CornerRadius="1" Background="{StaticResource SocietyBrush}" Opacity="0.7" />

            <!-- ============================ CONTENT ============================ -->
            <Grid Grid.Row="1" Margin="18,16,18,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>

                <!-- ---------- LEFT: process picker ---------- -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="TARGET PROCESS" Style="{StaticResource Label}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="ProcCount" Text="" Style="{StaticResource Label}"
                                       Foreground="{StaticResource Text1Brush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,12,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="10"
                                    Background="{StaticResource Bg2Brush}"
                                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                                <Grid>
                                    <TextBox x:Name="SearchBox" Style="{StaticResource Input}"
                                             Background="Transparent" BorderThickness="0"
                                             TextChanged="SearchBox_TextChanged" />
                                    <TextBlock x:Name="SearchHint" Text="Search processes…"
                                               IsHitTestVisible="False" Margin="13,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Text2Brush}" />
                                </Grid>
                            </Border>
                            <Button Grid.Column="2" x:Name="BtnRefresh"
                                    Style="{StaticResource GhostButton}" Width="44"
                                    Content="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                    Click="BtnRefresh_Click" ToolTip="Refresh list" />
                        </Grid>

                        <Border Grid.Row="2" CornerRadius="10"
                                Background="{StaticResource Bg2Brush}"
                                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                                Padding="6">
                            <ListBox x:Name="ProcListBox" Style="{StaticResource ProcList}"
                                     SelectionChanged="ProcListBox_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="8" Height="8"
                                                     Margin="0,0,12,0" VerticalAlignment="Center"
                                                     Fill="{StaticResource AccentBBrush}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource Text0Brush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Display}" FontSize="11"
                                                           Foreground="{StaticResource Text2Brush}" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Style="{StaticResource Pill}">
                                                <TextBlock Text="{Binding ArchLabel}" FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentCBrush}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </Border>

                <!-- ---------- RIGHT: payload + action + log ---------- -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- payload card -->
                    <Border Grid.Row="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="PAYLOAD DLL" Style="{StaticResource Label}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="DllPathBox"
                                         Style="{StaticResource Input}"
                                         IsReadOnly="True" Text="" />
                                <Button Grid.Column="2" x:Name="BtnBrowse" Width="110"
                                        Style="{StaticResource GhostButton}"
                                        Content="Browse…" Click="BtnBrowse_Click" />
                            </Grid>
                            <TextBlock x:Name="ArchWarning" Margin="2,10,0,0" FontSize="12"
                                       TextWrapping="Wrap" Visibility="Collapsed"
                                       Foreground="{StaticResource DangerBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- inject button -->
                    <Button Grid.Row="1" x:Name="BtnInject" Margin="0,14,0,0"
                            Style="{StaticResource PrimaryButton}"
                            Click="BtnInject_Click" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="INJECT" VerticalAlignment="Center"
                                       FontWeight="Bold" />
                        </StackPanel>
                    </Button>

                    <!-- log card -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="ACTIVITY" Style="{StaticResource Label}"
                                       Margin="0,0,0,10" />
                            <Border Grid.Row="1" CornerRadius="10"
                                    Background="{StaticResource Bg0Brush}"
                                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                                <ScrollViewer x:Name="LogScroller" Padding="14,12"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="LogList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Time}"
                                                               FontFamily="Consolas" FontSize="11.5"
                                                               Foreground="{StaticResource Text2Brush}"
                                                               Margin="0,0,10,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Text}"
                                                               FontFamily="Consolas" FontSize="12.5"
                                                               TextWrapping="Wrap"
                                                               Foreground="{Binding Brush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ============================ FOOTER ============================ -->
            <Border Grid.Row="2" Padding="20,10,20,14">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="9" Height="9"
                                 Fill="{StaticResource AccentCBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Text="ready" Margin="9,0,0,0"
                                   FontSize="12" Foreground="{StaticResource Text1Brush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="11" Foreground="{StaticResource Text2Brush}">
                        <Run Text="fsociety" Foreground="{StaticResource AccentBBrush}" />
                        <Run Text="· v1.0 · x64" />
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
