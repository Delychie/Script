<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================
         Windows Command Prompt palette — conhost black (#0C0C0C) with the
         default #CCCCCC foreground, plus the console ANSI green / red /
         yellow used for status tags. Monochrome by default, like real cmd.
         ================================================================ -->

    <Color x:Key="Console">#0C0C0C</Color> <!-- console background        -->
    <Color x:Key="CaptionBar">#F3F3F3</Color> <!-- Win10 light title bar  -->
    <Color x:Key="CaptionText">#1A1A1A</Color><!-- title bar text          -->
    <Color x:Key="Stroke">#333333</Color>  <!-- window border / scrollbar -->
    <Color x:Key="Fg">#CCCCCC</Color>      <!-- default foreground        -->
    <Color x:Key="Fg1">#9A9A9A</Color>     <!-- secondary                 -->
    <Color x:Key="Dim">#767676</Color>     <!-- dim / system text         -->
    <Color x:Key="White">#F2F2F2</Color>   <!-- bright white              -->
    <Color x:Key="Green">#16C60C</Color>   <!-- ok  [+]                   -->
    <Color x:Key="Red">#E74856</Color>     <!-- error [x]                 -->
    <Color x:Key="Yellow">#C19C00</Color>  <!-- warning [!]               -->

    <SolidColorBrush x:Key="ConsoleBrush"     Color="{StaticResource Console}" />
    <SolidColorBrush x:Key="CaptionBarBrush"  Color="{StaticResource CaptionBar}" />
    <SolidColorBrush x:Key="CaptionTextBrush" Color="{StaticResource CaptionText}" />
    <SolidColorBrush x:Key="StrokeBrush"   Color="{StaticResource Stroke}" />
    <SolidColorBrush x:Key="FgBrush"       Color="{StaticResource Fg}" />
    <SolidColorBrush x:Key="Fg1Brush"      Color="{StaticResource Fg1}" />
    <SolidColorBrush x:Key="DimBrush"      Color="{StaticResource Dim}" />
    <SolidColorBrush x:Key="WhiteBrush"    Color="{StaticResource White}" />
    <SolidColorBrush x:Key="GreenBrush"    Color="{StaticResource Green}" />
    <SolidColorBrush x:Key="RedBrush"      Color="{StaticResource Red}" />
    <SolidColorBrush x:Key="YellowBrush"   Color="{StaticResource Yellow}" />

</ResourceDictionary>
